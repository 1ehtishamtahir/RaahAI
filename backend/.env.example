# Copy to .env and fill
# Gemini (primary) — get key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxx
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Alibab Cloud Qwen (fallback legacy) — optional if Gemini not set
DASHSCOPE_API_KEY=sk-xxxx
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v2

# Database (Supabase or local postgres)
DATABASE_URL=postgresql://raahai:raahai@localhost:5432/raahai
# e.g. Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ChromaDB
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=raahai_gov_docs

# OCR
OCR_ENGINE=paddle  # paddle | tesseract
OCR_LANG=en,ur

# Whisper / TTS
WHISPER_MODEL=base

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Security
SECRET_KEY=change-me-in-production
